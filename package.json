{
  "name": "my-portfolio-op1",
  "version": "0.1.0",
  "description": "Self-hosted developer portfolio with a built-in CMS, admin dashboard, notes vault and utility kits. Next.js, MongoDB, Tailwind.",
  "keywords": [
    "portfolio",
    "cms",
    "nextjs",
    "mongodb",
    "developer-portfolio",
    "admin-dashboard",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": {
    "name": "MD. Habibullah Sharif",
    "url": "https://habibullah.dev"
  },
  "homepage": "https://habibullah.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md8-habibullah/my-portfolio-op1.git"
  },
  "bugs": {
    "url": "https://github.com/md8-habibullah/my-portfolio-op1/issues"
  },
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "preview": "next build && next start",
    "lint": "eslint --config eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
