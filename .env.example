# ==============================================================================
# GLOBAL-ID - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.example .env.local
#
# WARNING: Never commit real credentials. `.env*` files (except this template)
# are git-ignored.
#
# Next.js supports multiple environment files:
#   - .env.local       (Local overrides, applies to all environments)
#   - .env.development (Specific to 'next dev')
#   - .env.production  (Specific to 'next start' / production builds)
#
# IMPORTANT: Do NOT manually set NODE_ENV in these files. Next.js sets it to
# 'development' during `next dev` and 'production' during `next build` /
# `next start`.
#
# Minimum to run locally (`pnpm dev`):  MONGODB_URI, JWT_SECRET, ADMIN_PASSWORD
# In `next dev` the admin login skips the TOTP step; in production it is always
# enforced, so ADMIN_TOTP_SECRET is required there.
#
# Everything marked "optional" can stay empty - the matching feature is simply
# switched off.
# ==============================================================================

# ------------------------------------------------------------------------------
# SITE
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL: the public origin of your deployment (no trailing slash).
# Used for canonical URLs, sitemap.xml, robots.txt, llms.txt and JSON-LD.
# Falls back to Vercel's production domain, then to http://localhost:3000.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------------------
# DATABASE INFRASTRUCTURE (required)
# ------------------------------------------------------------------------------
# MONGODB_URI: The primary connection string for the MongoDB cluster.
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio_cms
MONGODB_URI=

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (required)
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographic signing key for session tokens.
# MUST BE at least 32 random characters. The system fails closed if absent.
# Generate via: openssl rand -base64 32
JWT_SECRET=

# ADMIN_PASSWORD: The master password required for administrative access.
# Use a long, unique password. It is verified with a constant-time comparison.
ADMIN_PASSWORD=

# ADMIN_TOTP_SECRET: Base32 secret for Time-Based One-Time Passwords
# (required in production). Generate it locally with:
#   node scripts/generate-totp.mjs
ADMIN_TOTP_SECRET=

# NOTES_TOTP_SECRET (optional): enables a 6-digit authenticator code as a quick
# unlock for the Notes Vault (45-minute session). Generate a separate secret with
# `node scripts/generate-totp.mjs`. Leave empty to unlock with the vault
# password only.
NOTES_TOTP_SECRET=

# ------------------------------------------------------------------------------
# MEDIA MANAGEMENT (CLOUDINARY) (optional)
# ------------------------------------------------------------------------------
# Cloudinary credentials for the Media Explorer, avatar and gallery uploads.
# Obtain these from your Cloudinary Management Console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# CONTACT FORM EMAIL (SMTP) (optional)
# ------------------------------------------------------------------------------
# Any SMTP provider works (Brevo, Resend SMTP, Mailgun, Postmark, Gmail app
# password...). Without these, the contact form answers "not configured".
# SMTP_HOST defaults to smtp-relay.brevo.com, SMTP_PORT to 587 (STARTTLS;
# 465 uses implicit TLS).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# CONTACT_TO_EMAIL: the inbox that receives contact-form submissions.
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL: the sender address (must be allowed by your SMTP provider).
# Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=

# ------------------------------------------------------------------------------
# NOTES VAULT (CLOUDFLARE R2 - IMAGE UPLOADS) (optional)
# ------------------------------------------------------------------------------
# Cloudflare R2 credentials for signed upload URLs inside the Notes Vault editor.
# Obtain ACCOUNT_ID from the Cloudflare dashboard -> R2 -> Overview.
# Create an API token with Object Read & Write permissions on the target bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2_BUCKET_NAME: The exact name of your R2 bucket.
R2_BUCKET_NAME=

# R2_PUBLIC_URL: The public base URL for serving stored objects.
# Example: https://pub-xxxx.r2.dev  OR a custom domain bound to the bucket.
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# ERROR TRACKING (SENTRY) (optional)
# ------------------------------------------------------------------------------
# Error reporting is off unless NEXT_PUBLIC_SENTRY_DSN is set. The CSP is
# extended automatically with the DSN's ingest host.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during production builds (all three are needed):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# SEO GEO TAGS (optional)
# ------------------------------------------------------------------------------
# Emitted as geo.region / geo.placename / geo.position / ICBM meta tags and
# schema.org GeoCoordinates. Leave empty to advertise no location.
# Example: SEO_GEO_REGION=DE-BE  SEO_GEO_PLACENAME="Berlin, Germany"
#          SEO_GEO_LAT=52.52     SEO_GEO_LON=13.405
SEO_GEO_REGION=
SEO_GEO_PLACENAME=
SEO_GEO_LAT=
SEO_GEO_LON=

# ------------------------------------------------------------------------------
# SHORT LINKS (optional)
# ------------------------------------------------------------------------------
# Each variable registers a redirect only when set:
#   /github   -> SOCIAL_GITHUB_URL     (https URL)
#   /linkedin -> SOCIAL_LINKEDIN_URL   (https URL)
#   /facebook -> SOCIAL_FACEBOOK_URL   (https URL)
#   /whatsapp -> https://wa.me/<WHATSAPP_NUMBER>  (digits only, with country code)
SOCIAL_GITHUB_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_FACEBOOK_URL=
WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# HEADER STATUS LINK (optional)
# ------------------------------------------------------------------------------
# If set, the header's uptime badge links to this page (e.g. your public status
# page). Otherwise the badge is plain text.
NEXT_PUBLIC_STATUS_URL=

# ------------------------------------------------------------------------------
# GITHUB PROFILE README SYNC (optional)
# ------------------------------------------------------------------------------
# If your GitHub profile README is generated from this CMS by a scheduled
# workflow, a CMS save can trigger it immediately via repository_dispatch
# (event type "cms-updated").
#   GITHUB_PROFILE_REPO:    "<username>/<username>" (your profile repository)
#   GITHUB_DISPATCH_TOKEN:  fine-grained PAT with `contents: write` on that repo only
# With either unset, this is a no-op.
GITHUB_PROFILE_REPO=
GITHUB_DISPATCH_TOKEN=
