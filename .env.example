# ==============================================================================
# my-portfolio-op1 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.example .env.local
#
# WARNING: Never commit real credentials. `.env*` files (except this template)
# are git-ignored.
#
# Only TWO values are required. Everything else - the admin authenticator and
# password, the notes-vault password, email (SMTP), Cloudinary, R2 and GitHub
# credentials - is configured in the admin panel: Admin -> Security & Keys.
# Secrets entered there are encrypted before they reach the database.
#
# Next.js supports multiple environment files:
#   - .env.local       (Local overrides, applies to all environments)
#   - .env.development (Specific to 'next dev')
#   - .env.production  (Specific to 'next start' / production builds)
#
# IMPORTANT: Do NOT manually set NODE_ENV in these files. Next.js sets it to
# 'development' during `next dev` and 'production' during `next build` /
# `next start`.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------------------
# MONGODB_URI: The primary connection string for the MongoDB cluster.
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio_cms
MONGODB_URI=

# JWT_SECRET: at least 32 random characters. It signs sessions, derives the
# first-run setup code and keys the encryption of secrets stored by the admin
# panel. The app fails closed if it is missing or too short.
# Generate via: openssl rand -base64 32
# (Rotating it later invalidates stored authenticator seeds and integration
# keys; you would set the admin up again and re-enter the keys.)
JWT_SECRET=

# ------------------------------------------------------------------------------
# FIRST RUN
# ------------------------------------------------------------------------------
# After the first start, open /administrator. You are asked for a setup code
# (printed in the server log, or run `node scripts/setup-code.mjs`) and then set
# up the mandatory authenticator and an optional password.
# Lost your authenticator?  node scripts/reset-admin-auth.mjs --yes

# ------------------------------------------------------------------------------
# SITE (recommended)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL: the public origin of your deployment (no trailing slash).
# Used for canonical URLs, sitemap.xml, robots.txt, llms.txt and JSON-LD.
# Falls back to Vercel's production domain, then to http://localhost:3000.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------------------
# OPTIONAL: values that cannot live in the database
# ------------------------------------------------------------------------------
# R2_PUBLIC_URL: public base URL of your Cloudflare R2 bucket (Notes Vault
# images). The Content-Security-Policy needs it at build time. The R2 *keys* are
# set in Admin -> Security & Keys.
# Example: https://pub-xxxx.r2.dev  OR a custom domain bound to the bucket.
R2_PUBLIC_URL=

# Error tracking (Sentry). Off unless a DSN is set; when off, no Sentry code is
# shipped to browsers. The CSP is extended automatically with the DSN's host.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during production builds (all three are needed):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# SEO geo tags: emitted as geo.region / geo.placename / geo.position / ICBM meta
# tags and schema.org GeoCoordinates. Leave empty to advertise no location.
# Example: SEO_GEO_REGION=DE-BE  SEO_GEO_PLACENAME="Berlin, Germany"
#          SEO_GEO_LAT=52.52     SEO_GEO_LON=13.405
SEO_GEO_REGION=
SEO_GEO_PLACENAME=
SEO_GEO_LAT=
SEO_GEO_LON=

# Short links: each variable registers a redirect only when set.
#   /github   -> SOCIAL_GITHUB_URL     (https URL)
#   /linkedin -> SOCIAL_LINKEDIN_URL   (https URL)
#   /facebook -> SOCIAL_FACEBOOK_URL   (https URL)
#   /whatsapp -> https://wa.me/<WHATSAPP_NUMBER>  (digits only, with country code)
SOCIAL_GITHUB_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_FACEBOOK_URL=
WHATSAPP_NUMBER=

# If set, the header's uptime badge links to this page (e.g. your public status
# page). Otherwise the badge is plain text.
NEXT_PUBLIC_STATUS_URL=

# Starting location of the prayer-times kit (any city listed in the kit).
# Default: Makkah.
NEXT_PUBLIC_PRAYER_DEFAULT_CITY=

# ------------------------------------------------------------------------------
# OPTIONAL FALLBACKS for credentials normally set in Admin -> Security & Keys
# ------------------------------------------------------------------------------
# A value set in the admin panel always wins; these are only used when the panel
# has no value for that field. Handy if your host has its own secret manager.
# Uncomment only what you need.
#
# Contact form email (any SMTP provider; host defaults to smtp-relay.brevo.com,
# port to 587):
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
#
# Cloudinary (media explorer, avatar and gallery uploads):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Cloudflare R2 (Notes Vault image uploads; see R2_PUBLIC_URL above):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
#
# GitHub profile README sync (repository_dispatch "cms-updated"):
# GITHUB_PROFILE_REPO=your-username/your-username
# GITHUB_DISPATCH_TOKEN=
